# General
ENVIRONMENT=dev

# API/Worker shared
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ebook
REDIS_URL=redis://redis:6379/0
CELERY_QUEUE_NAME=ebook.jobs.default

# Supabase
SUPABASE_URL=https://peqvdxrrnfwgdyozfwxq.supabase.co
SUPABASE_JWKS_URL=https://peqvdxrrnfwgdyozfwxq.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://peqvdxrrnfwgdyozfwxq.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ADMIN_ROLE=service_role

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_RAW_BUCKET=ebook-raw
R2_RESULT_BUCKET=ebook-result

# Upload/download policies
MAX_UPLOAD_BYTES=104857600
DAILY_JOBS_LIMIT_PER_USER=20
PRESIGNED_PUT_EXPIRES_SECONDS=900
PRESIGNED_GET_EXPIRES_SECONDS=600
OBJECT_TTL_HOURS=24

# Worker engine config
OPENAI_API_KEYS_CSV=
DEEPL_API_KEYS_CSV=
GOOGLE_API_KEYS_CSV=
DEEPINFRA_API_KEYS_CSV=
OPENAI_MODEL=gpt-4o
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3.2
DEEPINFRA_ENDPOINT=https://api.deepinfra.com/v1/openai/chat/completions

# UI
NEXT_PUBLIC_SUPABASE_URL=https://peqvdxrrnfwgdyozfwxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=d
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
